# ── Odd-meter funk grooves (7/8, 5/4, 3/4) ──

# Odd-meter funk grooves.
# Style: funk
# 7/8=14 steps | 5/4=10 steps | 3/4=6 steps
# Beat groups: 7/8=3+2+2, 5/4=3+2, 3/4=1+1+1
# X = accented hit, x = regular hit, . = rest, o = soft, g = ghost

[funk verse 7/8 intensity=0.20-0.60]
