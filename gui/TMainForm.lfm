object MainForm: TMainForm
  Left = 160
  Top = 120
  Caption = 'ChameleonDrummer'
  ClientHeight = 670
  ClientWidth = 960
  Menu = MainMenu
  OnCreate = FormCreate
  object MainMenu: TMainMenu
    object mnuFile: TMenuItem
      Caption = '&File'
      object mnuQuit: TMenuItem
        Caption = 'E&xit'
        OnClick = mnuQuitClick
      end
    end
    object mnuHelp: TMenuItem
      Caption = '&Help'
      object mnuAbout: TMenuItem
        Caption = '&About'
        OnClick = mnuAboutClick
      end
    end
  end
  object gbSong: TGroupBox
    Left = 12
    Top = 36
    Width = 396
    Height = 560
    Caption = 'Song'
    object rbPattern: TRadioButton
      Left = 12
      Top = 24
      Width = 180
      Height = 20
      Caption = 'Pattern (single pattern)'
      Checked = False
      OnClick = rgModeChange
    end
    object rbSong: TRadioButton
      Left = 200
      Top = 24
      Width = 180
      Height = 20
      Caption = 'Song (full structure)'
      Checked = True
      OnClick = rgModeChange
    end
    object lblGenre: TLabel
      Left = 12
      Top = 60
      Width = 60
      Height = 14
      Caption = 'Genre'
    end
    object cbGenre: TComboBox
      Left = 80
      Top = 56
      Width = 180
      Height = 24
      OnChange = cbGenreChange
    end
    object lblStyle: TLabel
      Left = 12
      Top = 92
      Width = 60
      Height = 14
      Caption = 'Style'
    end
    object cbStyle: TComboBox
      Left = 80
      Top = 88
      Width = 180
      Height = 24
    end
    object lblDrummer: TLabel
      Left = 12
      Top = 124
      Width = 60
      Height = 14
      Caption = 'Drummer'
    end
    object cbDrummer: TComboBox
      Left = 80
      Top = 120
      Width = 180
      Height = 24
    end
    object lblMapping: TLabel
      Left = 12
      Top = 160
      Width = 60
      Height = 14
      Caption = 'Keymap'
    end
    object cbMapping: TComboBox
      Left = 80
      Top = 156
      Width = 180
      Height = 24
    end
  end
  object gbOutput: TGroupBox
    Left = 420
    Top = 36
    Width = 396
    Height = 210
    Caption = 'Output'
    object lblExport: TLabel
      Left = 12
      Top = 28
      Width = 60
      Height = 14
      Caption = 'Export'
    end
    object cbExport: TComboBox
      Left = 80
      Top = 24
      Width = 300
      Height = 24
    end
    object lblFile: TLabel
      Left = 12
      Top = 62
      Width = 60
      Height = 14
      Caption = 'File'
    end
    object edOutput: TEdit
      Left = 80
      Top = 58
      Width = 248
      Height = 26
      Text = 'song'
    end
    object btnBrowse: TButton
      Left = 336
      Top = 56
      Width = 48
      Height = 28
      Caption = '...'
      OnClick = btnBrowseClick
    end
    object chkOpenFolder: TCheckBox
      Left = 12
      Top = 96
      Width = 370
      Height = 18
      Caption = 'Open the output folder when finished'
    end
    object lblHint: TLabel
      Left = 12
      Top = 126
      Width = 370
      Height = 72
      Caption = 'Writes <name>.mid, and with the export mode also <name>.rpp and <name>.ardour\'
      WordWrap = True
    end
  end
  object gbPerformance: TGroupBox
    Left = 420
    Top = 260
    Width = 396
    Height = 152
    Caption = 'Performance'
    object lblTempo: TLabel
      Left = 12
      Top = 28
      Width = 60
      Height = 14
      Caption = 'Tempo'
    end
    object seTempo: TSpinEdit
      Left = 80
      Top = 24
      Width = 80
      Height = 24
      MaxValue = 300
      MinValue = 0
      Value = 0
    end
    object lblTempoHint: TLabel
      Left = 170
      Top = 28
      Width = 210
      Height = 14
      Caption = 'BPM  (0 = style default)'
    end
    object lblComplexity: TLabel
      Left = 12
      Top = 66
      Width = 64
      Height = 14
      Caption = 'Complexity'
    end
    object tbComplexity: TTrackBar
      Left = 80
      Top = 62
      Width = 180
      Height = 24
      Max = 100
      Min = 0
      Position = 50
      OnChange = tbComplexityChange
    end
    object lblComplexityValue: TLabel
      Left = 268
      Top = 66
      Width = 50
      Height = 14
      Caption = '0.50'
    end
    object lblHumanization: TLabel
      Left = 12
      Top = 102
      Width = 64
      Height = 14
      Caption = 'Humanization'
    end
    object tbHumanization: TTrackBar
      Left = 80
      Top = 98
      Width = 180
      Height = 24
      Max = 100
      Min = 0
      Position = 30
      OnChange = tbHumanizationChange
    end
    object lblHumanizationValue: TLabel
      Left = 268
      Top = 102
      Width = 50
      Height = 14
      Caption = '0.30'
    end
  end
  object btnGenerate: TButton
    Left = 420
    Top = 428
    Width = 196
    Height = 40
    Caption = 'Generate'
    OnClick = btnGenerateClick
  end
  object btnOpenFolder: TButton
    Left = 628
    Top = 428
    Width = 188
    Height = 40
    Caption = 'Open output folder'
    OnClick = btnOpenFolderClick
  end
  object gbLog: TGroupBox
    Left = 12
    Top = 480
    Width = 804
    Height = 140
    Caption = 'Log'
    object memLog: TMemo
      Left = 8
      Top = 20
      Width = 788
      Height = 110
      ReadOnly = True
      ScrollBars = ssVertical
      WordWrap = True
    end
  end
  object lblStatus: TLabel
    Left = 16
    Top = 624
    Width = 560
    Height = 16
    Alignment = taLeftJustify
    Caption = 'Ready'
    ParentShowHint = False
    ShowHint = False
    Font.Color = clWindowText
    Font.Size = -11
  end
  object pbProgress: TProgressBar
    Left = 700
    Top = 624
    Width = 120
    Height = 16
    Visible = False
  end
end
